# --- Telegram ---
BOT_TOKEN=123456789:AAExampleTelegramBotToken
# Comma separated numeric Telegram user IDs that are allowed to use /admin
ADMIN_TELEGRAM_IDS=111111111,222222222

# --- irMarket (your reseller account) ---
IRMARKET_BASE_URL=https://api.irmarket.store
IRMARKET_API_KEY=anb_your_api_key_here

# --- Markup applied on top of irMarket's price_usd to get what YOUR users pay ---
# 1.30 = 30% markup. Change to 1.0 for no markup.
PRICE_MARKUP=1.30

# --- Demo wallet (no real payment gateway yet) ---
# Amount (USD) users get for free the first time they tap "Get test credit"
DEMO_CREDIT_AMOUNT=50
# Cooldown in hours before a user can request test credit again
DEMO_CREDIT_COOLDOWN_HOURS=24

# --- Webhook receiver (for irMarket order.updated callbacks) ---
# Public HTTPS URL where irMarket can reach this server, e.g. https://yourdomain.com
# Leave empty if you don't have a public URL yet; the bot will still work by
# polling order status instead of relying on the webhook.
WEBHOOK_PUBLIC_URL=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# --- Storage ---
DATABASE_PATH=bot.db
